# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Local PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/leadhunt"

# Application Server Port
PORT=3000

# Strategy Telegram Alerts (OFF by default; enable only when ready)
STRATEGY_ALERTS_ENABLED=false

# Telegram Bot (used by server-side broadcasts; never exposed to browsers)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ============================================================================
# Admin Panel & API Security (Phase 1)
# ============================================================================
# ALL THREE of ADMIN_USERNAME, ADMIN_PASSWORD_HASH, and SESSION_SECRET are
# required to enable admin login. If any is missing, /api/admin/login returns
# 503 ("Admin authentication is not configured"). Never uses defaults.
# Generate ADMIN_PASSWORD_HASH via: npm run admin:hash
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""
SESSION_SECRET=""

# Set to "false" ONLY while serving over plain HTTP (e.g. http://149.56.128.230:3000).
# Defaults to "true" (Secure cookie + HSTS). Switch back to "true" once HTTPS is enabled.
COOKIE_SECURE=true

# Secret required to call /api/cron and /api/telegram/cron (X-Cron-Secret, Bearer token, or ?secret=).
CRON_SECRET=""

# Optional comma-separated list of ADDITIONAL cross-origin URLs allowed by CORS.
# Same-origin requests ALWAYS work. Leave empty to allow same-origin only.
ALLOWED_ORIGINS=""

# Set to "true" ONLY when running behind a trusted reverse proxy (e.g. Caddy/Nginx).
TRUST_PROXY=false

# Optional comma-separated list of client IPs allowed to access /api/admin/* and admin endpoints.
# Leave empty to allow admin login from any IP.
ADMIN_ALLOWED_IPS=""

# Maximum simultaneous public SSE (/api/live-stream) connections allowed per IP.
MAX_SSE_PER_IP=20
